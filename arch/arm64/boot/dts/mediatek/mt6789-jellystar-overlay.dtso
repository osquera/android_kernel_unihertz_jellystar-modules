		fwm-name = "frsm-spk1.bin";
		sdz-gpios = <&pio 0x3a 0x0>;
		spkr-id = <0x1>;
		ref-rdc = <0x67fd>;
		status = "okay";
	};
};

&sound {
	mediatek,spk-i2s = <0x3 0x0>;

	mediatek,speaker-codec {
		sound-dai = <&speaker_amp>;
	};
};

&frsm_amp {
	compatible = "foursemi,frsm-amp";
	frsm,amp-ndev = <0x1>;
	frsm,misc-enable;
	frsm,class-enable;
	status = "okay";
};

&mmc1 {
	cd-gpios = <&pio 0x7 0x0>;
	vmmc-supply = <&mt6358_vmch_eint_low>;
};

&i2c6 {

	coulomb_mtk: coulomb@2f {
		compatible = "mediatek,coulomb";
		reg = <0x2f>;
		status = "okay";
	};
};

&irtx_pwm {
	pwm_ch = <0x0>;
};

&i2c7 {
	#address-cells = <0x1>;
	#size-cells = <0x0>;
	clock-frequency = <0x61a80>;

	aw2033: aw2033@45 {
		compatible = "awinic,aw2033_led";
		reg = <0x45>;
		status = "okay";
		aw2033,INT-gpio = <&pio 0x6 0x0>;

		aw2033,red {
			aw2033,name = "red";
			aw2033,id = <0x0>;
			aw2033,imax = <0x1>;
			aw2033,led-current = <0x3>;
			aw2033,max-brightness = <0xff>;
			aw2033,rise-time-ms = <0x6>;
			aw2033,hold-time-ms = <0x0>;
			aw2033,fall-time-ms = <0x6>;
			aw2033,off-time-ms = <0x4>;
		};

		aw2033,green {
			aw2033,name = "green";
			aw2033,id = <0x1>;
			aw2033,imax = <0x1>;
			aw2033,led-current = <0x3>;
			aw2033,max-brightness = <0xff>;
			aw2033,rise-time-ms = <0x6>;
			aw2033,hold-time-ms = <0x0>;
			aw2033,fall-time-ms = <0x6>;
			aw2033,off-time-ms = <0x4>;
		};

		aw2033,blue {
			aw2033,name = "blue";
			aw2033,id = <0x2>;
			aw2033,imax = <0x1>;
			aw2033,led-current = <0x3>;
			aw2033,max-brightness = <0xff>;
			aw2033,rise-time-ms = <0x6>;
			aw2033,hold-time-ms = <0x0>;
			aw2033,fall-time-ms = <0x6>;
			aw2033,off-time-ms = <0x4>;
		};
	};
};

&bp_thl {
	soc-limit-threshold = <0x0>;
};

&gpio_usage_mapping {
	GPIO_SIM1_HOT_PLUG = <&pio 0x17 0x0>;
	GPIO_SIM2_HOT_PLUG = <&pio 0x18 0x0>;
	GPIO_SIM1_SCLK = <&pio 0x4d 0x0>;
	GPIO_SIM1_SRST = <&pio 0x4e 0x0>;
	GPIO_SIM1_SIO = <&pio 0x4f 0x0>;
	GPIO_SIM2_SCLK = <&pio 0x50 0x0>;
	GPIO_SIM2_SRST = <&pio 0x51 0x0>;
	GPIO_SIM2_SIO = <&pio 0x52 0x0>;
	GPIO_FDD_BAND_SUPPORT_DETECT_1ST_PIN = <&pio 0x6f 0x0>;
};

