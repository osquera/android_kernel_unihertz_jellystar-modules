// SPDX-License-Identifier: GPL-2.0
/*
 * Unihertz Jelly Star (MT6789) board overlay, applied by the bootloader on top of mt6789.dtb.
 *
 * The board description (pins, GPIOs, regulators, panel, sensors, charger, LEDs, ...) is the
 * one the stock firmware ships (V01.00.04 DTBO and the additions in its base DTB), turned into
 * source with phandles written as labels of MediaTek's mt6789.dts. Applied to mt6789.dtb it
 * gives the stock device tree, except for properties where this tree's MediaTek release
 * differs; the video encoder node keeps the stock values (see below).
 */
/dts-v1/;
/plugin/;

/* Jelly Star additions to MediaTek's mt6789.dts (stock base DTB) */
&{/mtk_lpm/irq-remain-list} {
	level_disp_aal0: level-disp-aal0 {
		target = <&disp_aal0>;
		value = <0x0 0x0 0x0 0x0>;
	};
};

&{/soc} {
	frsm_amp: frsm_amp {
		compatible = "foursemi,frsm-amp";
		frsm,amp-ndev = <0x1>;
		frsm,misc-enable;
		frsm,class-enable;
		status = "okay";
	};
	tkcore: tkcore {
		compatible = "trustkernel,tzdrv";
	};
};

&i2c5 {
	rt1711h@4e {
		compatible = "richtek,rt1711h";
		reg = <0x4e>;
		status = "okay";
		rt-tcpc,name = "type_c_port0";
		rt-tcpc,role-def = <0x5>;
		rt-tcpc,rp-level = <0x0>;
		rt-tcpc,vconn-supply = <0x1>;
		rt1711pd,intr-gpio = <&pio 0x29 0x0>;
		rt1711pd,intr-gpio-num = <0x29>;

		displayport {
			1st-connection = "dfp-d";
			2nd-connection = "dfp-d";
			typec,receptacle;

			dfp-d {
				pin-assignment,mode-c;
				pin-assignment,mode-d;
				pin-assignment,mode-e;
			};

			ufp-d {
			};
		};

		dpm-caps {
			local-dr-power;
			local-dr-data;
			local-usb-comm;
			local-no-suspend;
			pr-check = <0x0>;
			dr-check = <0x0>;
		};

		pd-data {
			pd,vid = <0x29cf>;
			pd,pid = <0x1711>;
			pd,source-cap-ext = [cf 29 11 17 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00];
			pd,sink-cap-ext = <0xcf291117 0x0 0x100 0x0 0x12b010a 0xa000000>;
			pd,mfrs = "RichtekTCPC";
			pd,charging-policy = <0x31>;
			pd,source-pdo-size = <0x1>;
			pd,source-pdo-data = <0x19032>;
			pd,sink-pdo-size = <0x1>;
			pd,sink-pdo-data = <0x190c8>;
			pd,id-vdo-size = <0x6>;
			pd,id-vdo-data = <0xd14029cf 0x0 0x17110000 0x61000000 0x0 0x41000000>;
			bat,nr = <0x1>;

			bat-info0 {
				bat,vid = <0x29cf>;
				bat,pid = <0x1711>;
				bat,mfrs = "bat1";
				bat,design-cap = <0x1e>;
			};
		};
	};
	rt1718s_typec: rt1718s@40 {
		compatible = "richtek,rt1718s";
		reg = <0x40>;
		wakeup-source;
		status = "okay";
		tcpc,name = "type_c_port0";
		tcpc,role-def = <0x5>;
		tcpc,rp-level = <0x0>;
		tcpc,vconn-supply = <0x1>;
		interrupts-extended = <&pio 0x2a 0x8>;
		tcpc,en-ctd;

		displayport {
			1st-connection = "dfp-d";
			2nd-connection = "dfp-d";
			typec,receptacle;

			dfp-d {
				pin-assignment,mode-c;
				pin-assignment,mode-d;
				pin-assignment,mode-e;
			};

			ufp-d {
			};
		};

		dpm-caps {
			local-dr-power;
			local-dr-data;
			local-usb-comm;
			local-no-suspend;
			pr-check = <0x0>;
			dr-check = <0x0>;
		};

		pd-data {
			pd,vid = <0x29cf>;
			pd,pid = <0x1718>;
			pd,source-cap-ext = [cf 29 18 17 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 00];
			pd,sink-cap-ext = <0xcf291817 0x0 0x100 0x0 0x12b010a 0xa000000>;
			pd,mfrs = "RichtekTCPC";
			pd,charging-policy = <0x31>;
			pd,source-pdo-size = <0x1>;
			pd,source-pdo-data = <0x19032>;
			pd,sink-pdo-size = <0x1>;
			pd,sink-pdo-data = <0x190c8>;
			pd,id-vdo-size = <0x6>;
			pd,id-vdo-data = <0xd14029cf 0x0 0x17180000 0x61000000 0x0 0x41000000>;
			bat,nr = <0x1>;

			bat-info0 {
				bat,vid = <0x29cf>;
				bat,pid = <0x1718>;
				bat,mfrs = "bat1";
				bat,design-cap = <0x1e>;
			};
		};
	};
	rt9471@53 {
		compatible = "richtek,rt9471";
		reg = <0x53>;
		ceb-gpios = <&pio 0x3 0x0>;
		wakeup-source;
		interrupts-extended = <&pio 0x4 0x2>;
		interrupt-controller;
		#interrupt-cells = <0x1>;
		chg_name = "primary_chg";
		chg_alias_name = "rt9471_chg";
		phys = <&u2port0 0x3>;
		phy-names = "usb2-phy";
		usb = <&usb>;

		rt9471_otg_vbus: otg-vbus {
			regulator-compatible = "otg-vbus";
			regulator-min-microvolt = <0x4a0150>;
			regulator-max-microvolt = <0x50df20>;
			regulator-min-microamp = <0x7a120>;
			regulator-max-microamp = <0x124f80>;
		};
	};
};


&mtk_gauge {
	io-channels = <&pmic_auxadc 0x3 &pmic_auxadc 0x0 &pmic_auxadc 0xe &pmic_auxadc 0xf &pmic_auxadc 0x10 &pmic_auxadc 0x2>;
	io-channel-names = "pmic_battery_temp", "pmic_battery_voltage", "pmic_bif_voltage", "pmic_ptim_voltage", "pmic_ptim_r", "pmic_vbus";
};

&mtk_lpm {
	irq-remain = <&edge_keypad &edge_mdwdt &level_btif_tx &level_btif_rx &level_usb &level_disp_aal0>;
};

&mt6366keys {
	/* MediaTek's second key is "home" with KEY_VOLUMEUP; on the Jelly Star it is the
	 * programmable side key, keycode 250 (as stock) */
	home {
		linux,keycodes = <0xfa>;
		wakeup-source;
	};
};

&{/soc/venc@17000000} {
	/* stock's values; our encoder driver (from OnePlus' mt6993 tree) works with these */
	venc-core-count = <0x1>;
	port-def = <0x0 0x100e0 0x0 0x0 0x100e1 0x0 0x0 0x100e2 0x0 0x0 0x100e3 0x0 0x0 0x100e4 0x0 0x0 0x100e5 0x0 0x0 0x100e6 0x0 0x0 0x100e7 0x0 0x0 0x100e8 0x0 0x0 0x100e9 0x0 0x0 0x100ea 0x0 0x0 0x100eb 0x0 0x0 0x100ec 0x0>;
	throughput-table = <0x34363248 0x1 0x47c 0x47c 0xed77040 0x64 0x34363248 0x4 0x35c 0x35c 0xed77040 0x64 0x34363248 0x8 0x30c 0x30c 0xed77040 0x64 0x34363248 0xc 0x35c 0x35c 0xed77040 0x64 0x34363248 0x11 0x1ae 0x1ae 0xed77040 0x64 0x43564548 0x1 0x47c 0x47c 0xed77040 0x64 0x43564548 0x4 0x35c 0x35c 0xed77040 0x64 0x43564548 0x8 0x30c 0x30c 0xed77040 0x64 0x43564548 0xc 0x35c 0x35c 0xed77040 0x64 0x43564548 0x11 0x1ae 0x1ae 0xed77040 0x64 0x35363248 0x1 0x47c 0x47c 0xed77040 0x64 0x35363248 0x4 0x35c 0x35c 0xed77040 0x64 0x35363248 0x8 0x30c 0x30c 0xed77040 0x64 0x43564548 0xc 0x35c 0x35c 0xed77040 0x64 0x35363248 0x11 0x1ae 0x1ae 0xed77040 0x64 0x46494548 0x1 0x47c 0x47c 0xed77040 0x64 0x46494548 0x4 0x35c 0x35c 0xed77040 0x64 0x46494548 0x8 0x30c 0x30c 0xed77040 0x64 0x43564548 0xc 0x35c 0x35c 0xed77040 0x64 0x46494548 0x11 0x1ae 0x1ae 0xed77040 0x64>;
};

&pio {

	camera_pins_cam0_rst_0: cam0@0 {

		pins_cmd_dat {
			pinmux = <0x1400>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam0_rst_1: cam0@1 {

		pins_cmd_dat {
			pinmux = <0x1400>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam1_rst_0: cam1@0 {

		pins_cmd_dat {
			pinmux = <0x1000>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam1_rst_1: cam1@1 {

		pins_cmd_dat {
			pinmux = <0x1000>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam0_pnd_0: cam0@2 {

		pins_cmd_dat {
			pinmux = <0x1300>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam0_pnd_1: cam0@3 {

		pins_cmd_dat {
			pinmux = <0x1300>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam1_pnd_0: cam1@2 {

		pins_cmd_dat {
			pinmux = <0xf00>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam1_pnd_1: cam1@3 {

		pins_cmd_dat {
			pinmux = <0xf00>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam0_ldo_vcama_0: cam0@vcam0 {

		pins_cmd_dat {
			pinmux = <0x2200>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam0_ldo_vcama_1: cam0@vcam1 {

		pins_cmd_dat {
			pinmux = <0x2200>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam1_ldo_vcama_0: cam1@vcam0 {

		pins_cmd_dat {
			pinmux = <0x2400>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam1_ldo_vcama_1: cam1@vcam1 {

		pins_cmd_dat {
			pinmux = <0x2400>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam0_ldo_vcama1_0: cam0@vcam2 {

		pins_cmd_dat {
			pinmux = <0x1200>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam0_ldo_vcama1_1: cam0@vcam3 {

		pins_cmd_dat {
			pinmux = <0x1200>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam0_ldo_vcamd_0: cam0@vcam4 {

		pins_cmd_dat {
			pinmux = <0x2300>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam0_ldo_vcamd_1: cam0@vcam5 {

		pins_cmd_dat {
			pinmux = <0x2300>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam1_ldo_vcamd_0: cam1@vcam4 {

		pins_cmd_dat {
			pinmux = <0x2500>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam1_ldo_vcamd_1: cam1@vcam5 {

		pins_cmd_dat {
			pinmux = <0x2500>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam0_ldo_vcamio_0: cam0@vcam6 {

		pins_cmd_dat {
			pinmux = <0x1200>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam0_ldo_vcamio_1: cam0@vcam7 {

		pins_cmd_dat {
			pinmux = <0x1200>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam1_ldo_vcamio_0: cam1@vcam6 {

		pins_cmd_dat {
			pinmux = <0x1200>;
			slew-rate = <0x1>;
			output-low;
		};
	};

	camera_pins_cam1_ldo_vcamio_1: cam1@vcam7 {

		pins_cmd_dat {
			pinmux = <0x1200>;
			slew-rate = <0x1>;
			output-high;
		};
	};

	camera_pins_cam0_mclk_off: camera_pins_cam0_mclk_off {

		pins_cmd_dat {
			pinmux = <0x8000>;
			drive-strength = <0x1>;
		};
	};

	camera_pins_cam0_mclk_2ma: camera_pins_cam0_mclk_2ma {

		pins_cmd_dat {
			pinmux = <0x8001>;
			drive-strength = <0x0>;
		};
	};

	camera_pins_cam0_mclk_4ma: camera_pins_cam0_mclk_4ma {

		pins_cmd_dat {
			pinmux = <0x8001>;
			drive-strength = <0x1>;
		};
	};

	camera_pins_cam0_mclk_6ma: camera_pins_cam0_mclk_6ma {

		pins_cmd_dat {
			pinmux = <0x8001>;
			drive-strength = <0x2>;
		};
	};

	camera_pins_cam0_mclk_8ma: camera_pins_cam0_mclk_8ma {

		pins_cmd_dat {
			pinmux = <0x8001>;
			drive-strength = <0x3>;
		};
	};

	camera_pins_cam1_mclk_off: camera_pins_cam1_mclk_off {

		pins_cmd_dat {
			pinmux = <0x7e00>;
			drive-strength = <0x1>;
		};
	};

	camera_pins_cam1_mclk_2ma: camera_pins_cam1_mclk_2ma {

		pins_cmd_dat {
			pinmux = <0x7e01>;
			drive-strength = <0x0>;
		};
	};

	camera_pins_cam1_mclk_4ma: camera_pins_cam1_mclk_4ma {

		pins_cmd_dat {
			pinmux = <0x7e01>;
			drive-strength = <0x1>;
		};
	};

	camera_pins_cam1_mclk_6ma: camera_pins_cam1_mclk_6ma {

		pins_cmd_dat {
			pinmux = <0x7e01>;
			drive-strength = <0x2>;
		};
	};

	camera_pins_cam1_mclk_8ma: camera_pins_cam1_mclk_8ma {

		pins_cmd_dat {
			pinmux = <0x7e01>;
			drive-strength = <0x3>;
		};
	};

	camera_pins_default: camera_pins_default {
	};
};

&kd_camera_hw1 {
	pinctrl-names = "default", "cam0_rst0", "cam0_rst1", "cam1_rst0", "cam1_rst1", "cam0_pnd0", "cam0_pnd1", "cam0_ldo_vcama_0", "cam0_ldo_vcama_1", "cam1_ldo_vcama_0", "cam1_ldo_vcama_1", "cam0_ldo_vcama1_0", "cam0_ldo_vcama1_1", "cam0_ldo_vcamd_0", "cam0_ldo_vcamd_1", "cam1_ldo_vcamd_0", "cam1_ldo_vcamd_1", "cam0_ldo_vcamio_0", "cam0_ldo_vcamio_1", "cam1_ldo_vcamio_0", "cam1_ldo_vcamio_1", "cam0_mclk_off", "cam0_mclk_2mA", "cam0_mclk_4mA", "cam0_mclk_6mA", "cam0_mclk_8mA", "cam1_mclk_off", "cam1_mclk_2mA", "cam1_mclk_4mA", "cam1_mclk_6mA", "cam1_mclk_8mA";
	pinctrl-0 = <&camera_pins_default>;
	pinctrl-1 = <&camera_pins_cam0_rst_0>;
	pinctrl-2 = <&camera_pins_cam0_rst_1>;
	pinctrl-3 = <&camera_pins_cam1_rst_0>;
	pinctrl-4 = <&camera_pins_cam1_rst_1>;
	pinctrl-5 = <&camera_pins_cam0_pnd_0>;
	pinctrl-6 = <&camera_pins_cam0_pnd_1>;
	pinctrl-7 = <&camera_pins_cam0_ldo_vcama_0>;
	pinctrl-8 = <&camera_pins_cam0_ldo_vcama_1>;
	pinctrl-9 = <&camera_pins_cam1_ldo_vcama_0>;
	pinctrl-10 = <&camera_pins_cam1_ldo_vcama_1>;
	pinctrl-11 = <&camera_pins_cam0_ldo_vcama1_0>;
	pinctrl-12 = <&camera_pins_cam0_ldo_vcama1_1>;
	pinctrl-13 = <&camera_pins_cam0_ldo_vcamd_0>;
	pinctrl-14 = <&camera_pins_cam0_ldo_vcamd_1>;
	pinctrl-15 = <&camera_pins_cam1_ldo_vcamd_0>;
	pinctrl-16 = <&camera_pins_cam1_ldo_vcamd_1>;
	pinctrl-17 = <&camera_pins_cam0_ldo_vcamio_0>;
	pinctrl-18 = <&camera_pins_cam0_ldo_vcamio_1>;
	pinctrl-19 = <&camera_pins_cam1_ldo_vcamio_0>;
	pinctrl-20 = <&camera_pins_cam1_ldo_vcamio_1>;
	pinctrl-21 = <&camera_pins_cam0_mclk_off>;
	pinctrl-22 = <&camera_pins_cam0_mclk_2ma>;
	pinctrl-23 = <&camera_pins_cam0_mclk_4ma>;
	pinctrl-24 = <&camera_pins_cam0_mclk_6ma>;
	pinctrl-25 = <&camera_pins_cam0_mclk_8ma>;
	pinctrl-26 = <&camera_pins_cam1_mclk_off>;
	pinctrl-27 = <&camera_pins_cam1_mclk_2ma>;
	pinctrl-28 = <&camera_pins_cam1_mclk_4ma>;
	pinctrl-29 = <&camera_pins_cam1_mclk_6ma>;
	pinctrl-30 = <&camera_pins_cam1_mclk_8ma>;
	cam0_pin_mclk = "mclk";
	cam0_pin_rst = "gpio";
	cam0_pin_pdn = "gpio";
	cam0_pin_vcama = "gpio";
	cam0_pin_vcamio = "gpio";
	cam0_pin_vcamd = "gpio";
	cam0_pin_vcama1 = "gpio";
	cam0_pin_vcamaf = "gpio";
	cam1_pin_mclk = "mclk";
	cam1_pin_rst = "gpio";
	cam1_pin_pdn = "gpio";
	cam1_pin_vcama = "gpio";
	cam1_pin_vcamio = "gpio";
	cam1_pin_vcamd = "gpio";
	cam1_pin_vcama1 = "gpio";
	cam1_pin_vcamaf = "gpio";
	cam0_enable_sensor = "s5kgm2_mipi_raw s5kgm2gms_mipi_raw";
	cam1_enable_sensor = "imx219_mipi_raw imx219gms_mipi_raw";
	status = "okay";
};

&i2c4 {
	status = "okay";
	clock-frequency = <0x61a80>;
	#address-cells = <0x1>;
	#size-cells = <0x0>;

	mtk_camera_eeprom1: camera-eeprom1@51 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x51>;
		status = "okay";
	};

	camera_sub_mtk: camera_sub_mtk@1a {
		compatible = "mediatek,camera_sub";
		#thermal-sensor-cells = <0x0>;
		reg = <0x1a>;
		status = "okay";
	};
};

&i2c8 {
	status = "okay";
	clock-frequency = <0x61a80>;
	#address-cells = <0x1>;
	#size-cells = <0x0>;

	mtk_camera_eeprom0: camera-eeprom0@50 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x50>;
		status = "okay";
	};

	camera_main_mtk: camera_main@1a {
		compatible = "mediatek,camera_main";
		#thermal-sensor-cells = <0x0>;
		reg = <0x1a>;
		status = "okay";
	};
};

&thermal_zones {

	camera_main: camera_main {
		polling-delay = <0x3e8>;
		polling-delay-passive = <0x0>;
		thermal-sensors = <&camera_main_mtk>;
	};

	camera_sub: camera_sub {
		polling-delay = <0x3e8>;
		polling-delay-passive = <0x0>;
		thermal-sensors = <&camera_sub_mtk>;
	};
};

&reserved_memory {

	tkcore {
		compatible = "trustkernel,shared_mem";
		no-map;
		size = <0x0 0x1000000>;
		alignment = <0x0 0x1000>;
		alloc-ranges = <0x0 0x40000000 0x0 0x80000000>;
	};
};

&{/} {

	agold_gms_board {
		compatible = "agold,agold_gms_board";
		agold_board_check = <0x1>;
		agold_board_adc = <0x514 0x5dc>;
		gms_id_channel = <0x6>;
		io-channels = <&auxadc 0x6>;
		io-channel-names = "agold_board_id";
		status = "okay";
	};

	agold_auxadc4: agold_auxadc4 {
		compatible = "agold,auxadc4";
		io-channels = <&auxadc 0x4>;
		io-channel-names = "g_channel4";
	};

	agold_auxadc5: agold_auxadc5 {
		compatible = "agold,auxadc5";
		io-channels = <&auxadc 0x5>;
		io-channel-names = "g_channel5";
	};

	touch_pad: touch_pad {
		compatible = "mediatek,touch_pad";
	};

	lampbelt_leds: lampbelt_leds {
		compatible = "agold,lampbelt_leds";
		lampbelt_leds,gpio_pwr = <&pio 0x6a 0x0 &pio 0x78 0x0>;
		lampbelt_leds,nums = <0x2>;
		lampbelt_leds,gpio_en = <&pio 0x6b 0x0 &pio 0x68 0x0>;
		lampbelt_leds,pwm_ch = <0x2>;
