&goodix_fp {
	interrupt-parent = <&pio>;
	interrupts = <0x8 0x8>;
	status = "okay";
};

&touch {
	interrupt-parent = <&pio>;
	interrupts = <0x9 0x2>;
	status = "okay";
};

&dsi_te {
	interrupt-parent = <&pio>;
	interrupts = <0x53 0x1>;
	status = "okay";
};

&md1_sim1_hot_plug_eint {
	compatible = "mediatek,md1_sim1_hot_plug_eint-eint";
	interrupts = <0x0 0x8>;
	debounce = <0x0 0x2710>;
	dedicated = <0x0 0x0>;
	src_pin = <0x0 0x1>;
	sockettype = <0x0 0x0>;
	status = "okay";
};

&md1_sim2_hot_plug_eint {
	compatible = "mediatek,md1_sim2_hot_plug_eint-eint";
	interrupts = <0x1 0x8>;
	debounce = <0x1 0x2710>;
	dedicated = <0x1 0x0>;
	src_pin = <0x1 0x2>;
	sockettype = <0x1 0x0>;
	status = "okay";
};

&keypad {
	mediatek,key-debounce = <0x400>;
	mediatek,sw-pwrkey = <0x74>;
	mediatek,hw-pwrkey = <0x8>;
	mediatek,sw-rstkey = <0x66>;
	mediatek,hw-rstkey = <0x11>;
	mediatek,use-extend-type = <0x0>;
	mediatek,hw-map-num = <0x48>;
	mediatek,hw-init-map = <0x73 0x72 0xf9 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
	mediatek,pwrkey-eint-gpio = <0x0>;
	mediatek,pwkey-gpio-din = <0x0>;
	mediatek,hw-dl-key0 = <0x0>;
	mediatek,hw-dl-key1 = <0x1>;
	mediatek,hw-dl-key2 = <0x8>;
	mediatek,hw-recovery-key = <0x0>;
	status = "okay";
};
