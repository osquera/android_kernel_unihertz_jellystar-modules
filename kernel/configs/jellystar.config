# Jelly Star (Unihertz, MT6789) settings on top of mgk_64_k612_defconfig + entry_level.config.
# TrustKernel TEE (the stock driver's build options: fingerprint SPI and RPMB forwarding on,
# no legacy /dev/tkcoredrv, no GP CA authentication).
CONFIG_TRUSTKERNEL_TEE_SUPPORT=m
CONFIG_TRUSTKERNEL_TEE_FP_SUPPORT=y
CONFIG_TRUSTKERNEL_TEE_RPMB_SUPPORT=y
# CONFIG_TRUSTKERNEL_TEE_LEGACY_CLIENT_DEVICE is not set
# CONFIG_TRUSTKERNEL_TEE_GP_CA_AUTH is not set
