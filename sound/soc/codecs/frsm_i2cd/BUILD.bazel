# Jelly Star: FourSemi FS19xx amplifier driver, built as the stock module name snd-soc-fs19xx.
# FRSM_COMPAT_EXPORT: mtk-sp-spk-amp owns the amp's I2C client and probes it through
# exfrsm_i2c_probe(), as on stock. FRSM_NO_ADSP: no ADSP protection path, as the stock module.
load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob([
        "*.c",
        "*.h",
        "Makefile",
    ]),
)

define_mgk_ddk_ko(
    name = "snd-soc-fs19xx",
    srcs = glob([
        "*.h",
    ]) + [
        "frsm-i2c.c",
        "frsm-amp-drv.c",
    ],
    includes = ["."],
    local_defines = [
        "FRSM_COMPAT_EXPORT",
        "FRSM_NO_ADSP",
    ],
)
